{
  "title": "Thai Promo Scraper (Umbrella)",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "enable_truemoney": {
      "title": "TrueMoney",
      "type": "boolean",
      "description": "Scrape truemoney.com/promotion.",
      "default": true,
      "editor": "checkbox",
      "groupCaption": "Sites",
      "groupDescription": "Which promo sites to scrape. At least one must be enabled."
    },
    "enable_seven_eleven": {
      "title": "7-Eleven",
      "type": "boolean",
      "description": "Scrape 7eleven.co.th/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_aeon": {
      "title": "AEON",
      "type": "boolean",
      "description": "Scrape aeon.co.th/aeon/promotions.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_umayplus": {
      "title": "U-May Plus",
      "type": "boolean",
      "description": "Scrape umayplus.com/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_firstchoice": {
      "title": "First Choice",
      "type": "boolean",
      "description": "Scrape firstchoice.co.th/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_kbj": {
      "title": "KBJ Capital",
      "type": "boolean",
      "description": "Scrape kbjcapital.co.th/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "details": {
      "title": "Fetch details",
      "type": "boolean",
      "description": "Fetch each promo's detail page for full terms, published_at, and modified_at. Adds one request per promo, so it roughly triples runtime (e.g. ~1 min to ~3 min for a full run).",
      "default": false,
      "editor": "checkbox",
      "groupCaption": "Options",
      "groupDescription": "Scrape options. All fields are optional."
    },
    "maxItems": {
      "title": "Max promos per site",
      "type": "integer",
      "description": "Cap the number of promos scraped per site per run, useful for a quick sample. 0 means no limit (scrape every promo on the page).",
      "default": 0,
      "minimum": 0,
      "editor": "number"
    }
  }
}
