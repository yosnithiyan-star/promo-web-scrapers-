{
  "title": "Thai Promo Scraper (Umbrella)",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "details": {
      "title": "Fetch details",
      "type": "boolean",
      "description": "Fetch each promo's detail page for terms, published_at, and modified_at. Adds per-promo requests and runtime.",
      "default": false,
      "editor": "checkbox"
    },
    "maxItems": {
      "title": "Max promos per site",
      "type": "integer",
      "description": "Maximum number of promos to scrape per site per run. 0 means no limit (scrape all).",
      "default": 0,
      "minimum": 0,
      "editor": "number"
    },
    "enable_truemoney": {
      "title": "TrueMoney",
      "type": "boolean",
      "description": "Scrape truemoney.com/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_seven_eleven": {
      "title": "7-Eleven",
      "type": "boolean",
      "description": "Scrape 7eleven.co.th/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_aeon": {
      "title": "AEON",
      "type": "boolean",
      "description": "Scrape aeon.co.th/aeon/promotions.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_umayplus": {
      "title": "U-May Plus",
      "type": "boolean",
      "description": "Scrape umayplus.com/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_firstchoice": {
      "title": "First Choice",
      "type": "boolean",
      "description": "Scrape firstchoice.co.th/promotion.",
      "default": true,
      "editor": "checkbox"
    },
    "enable_kbj": {
      "title": "KBJ Capital",
      "type": "boolean",
      "description": "Scrape kbjcapital.co.th/promotion.",
      "default": true,
      "editor": "checkbox"
    }
  }
}
